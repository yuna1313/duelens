 x="313" y="316" width="160" height="30" as="geometry" /></mxCell><mxCell id="idempotency_requests-expires_at-3" value="N" style="rounded=0;html=0;fillColor=#f4f7f8;strokeColor=none;align=left;spacingLeft=10;fontFamily=Menlo;fontSize=15;" vertex="1" parent="idempotency_requests"><mxGeometry x="473" y="316" width="57" height="30" as="geometry" /></mxCell><mxCell id="FK-01" value="FK-01 과목 소유" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#426B65;strokeWidth=2;dashed=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=15;labelBackgroundColor=#F7F9FA;exitX=0.22641509433962265;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="users" target="courses"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="630" /><mxPoint x="370" y="630" /></Array></mxGeometry></mxCell><mxCell id="FK-02" value="FK-02 필수 과목" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#426B65;strokeWidth=2;dashed=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=15;labelBackgroundColor=#F7F9FA;exitX=1.0;exitY=0.2439516129032258;entryX=0.0;entryY=0.3255395683453237;" edge="1" parent="1" source="courses" target="tasks"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="821" /><mxPoint x="750" y="881" /></Array></mxGeometry></mxCell><mxCell id="FK-03" value="FK-03 변경 기록" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#426B65;strokeWidth=2;dashed=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=15;labelBackgroundColor=#F7F9FA;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="tasks" target="task_history"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="1310" /><mxPoint x="400" y="1310" /></Array></mxGeometry></mxCell><mxCell id="FK-04" value="FK-04 요청 결과 보관" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#426B65;strokeWidth=2;dashed=0;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=15;labelBackgroundColor=#F7F9FA;exitX=0.9433962264150944;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="users" target="idempotency_requests"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1330" y="620" /><mxPoint x="1955" y="620" /></Array></mxGeometry></mxCell><mxCell id="rules" value="관계·무결성 규칙&#10;FK-01  courses.user_id → users.id&#10;FK-02  tasks.course_id → courses.id (NOT NULL)&#10;FK-03  task_history.task_id → tasks.id&#10;FK-04  idempotency_requests.user_id → users.id&#10;tasks에 user_id·학기·과목명·분반을 중복 저장하지 않습니다.&#10;조회·변경 시 courses.user_id = 세션 사용자 조건을 검사합니다.&#10;과목 삭제는 deleted_at으로 표시하고 과제·이력을 보존합니다.&#10;학교 비밀번호는 users에 저장하지 않습니다.&#10;구독·결제·추가 기능 권한은 추후 users에 별도로 연결합니다.&#10;정식 로그인·iClass 연결·구독 테이블은 후속 설계입니다." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fillColor=#FFFFFF;strokeColor=#DBE3E7;fontSize=18;" vertex="1" parent="1"><mxGeometry x="850" y="1445" width="1370" height="365" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>